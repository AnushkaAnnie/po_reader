# ─────────────────────────────────────────────
#  SRM AUTOMATION - ENVIRONMENT TEMPLATE
#  Copy this to .env and fill in your values
# ─────────────────────────────────────────────

# ── Customer 1: V2 Retail ──
V2RETAIL_SRM_URL=
V2RETAIL_SRM_USER=
V2RETAIL_SRM_PASS=
V2RETAIL_SHEET_ID=

# ── Add more customers below ──
# CUSTOMER2_SRM_URL=
# CUSTOMER2_SRM_USER=
# CUSTOMER2_SRM_PASS=
# CUSTOMER2_SHEET_ID=

# ── Google Sheets ──
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json

# ── Notifications ──
SLACK_WEBHOOK_URL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=

# ── Settings ──
HEADLESS=true
LOG_LEVEL=INFO
